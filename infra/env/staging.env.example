# JastipKita API — STAGING (Cloudflare Workers Free + Neon Free, Xendit TEST). Names mirror apps/api/src/env.ts.
# This file documents WHERE each value lives. It is never loaded as-is:
#   [TOML]    non-secret default in infra/cloudflare/wrangler.toml [env.staging.vars]
#   [VAR]     GitHub Environment "staging" → Variables  (overrides [TOML] at deploy time via --var)
#   [SECRET]  GitHub Environment "staging" → Secrets    (pushed to the Worker with `wrangler secret bulk`)
# Generate JWT_SECRET / DATA_ENCRYPTION_KEYS / HMAC_PEPPER:  bash scripts/gen-secrets.sh staging --db-passwords

# ---- app
APP_ENV=staging                                   # [TOML] locked
APP_NAME=JastipKita                               # [TOML]
APP_VERSION=                                      # set by CI: <package version>+<commit>
API_BASE_URL=https://jastipkita-api-staging.<subdomain>.workers.dev   # [VAR] required
WEB_BASE_URL=https://antarkitaindonesia.com/jastipkita                 # [TOML]/[VAR]
ADMIN_BASE_URL=https://staging.<pages-project>.pages.dev              # [VAR] (admin origin, used by CORS)
CORS_ORIGINS=https://antarkitaindonesia.com       # [TOML]/[VAR] origins only (no path)
LOG_LEVEL=info                                    # [TOML]
PORT=8787                                         # unused on Workers

# ---- database: Neon, region aws-ap-southeast-1 (Singapore)
# POOLED connection string of jk_api_staging (host contains "-pooler"), sslmode=require. The Worker opens one
# connection per request with prepare=false (src/worker.ts).
DATABASE_URL=postgres://jk_api_staging:<password>@<endpoint>-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require   # [SECRET]
DB_POOL_MAX=1                                     # [TOML] (Workers: 1 connection per request)
DB_PROVIDER=neon                                  # [TOML]

# ---- auth & crypto
JWT_SECRET=                                       # [SECRET] ≥ 32 chars
JWT_ISSUER=jastipkita-api
JWT_AUDIENCE=jastipkita
ACCESS_TOKEN_TTL_SEC=900                          # [TOML]
REFRESH_TOKEN_TTL_DAYS=30                         # [TOML]
ADMIN_MFA_STEP_UP_SEC=900                         # [TOML]
DATA_ENCRYPTION_KEYS=                             # [SECRET] "kid:base64(32 bytes)", active key first
HMAC_PEPPER=                                      # [SECRET] never change once data exists
GOOGLE_CLIENT_IDS=                                # [VAR] public OAuth client ids (web,android,ios)
APPLE_CLIENT_IDS=                                 # [VAR] bundle id / service id
OTP_DEV_ECHO=false                                # [TOML] locked — env.ts refuses true on staging

# ---- payments: Xendit TEST mode (keys start with xnd_development_). /v1/health must say SANDBOX (or MOCK).
PAYMENT_PROVIDER=xendit                           # [TOML]; set [VAR] PAYMENT_PROVIDER=mock only until Xendit test keys exist
XENDIT_ENV=test                                   # [TOML] locked — CI refuses live on staging
XENDIT_BASE_URL=https://api.xendit.co             # [TOML]
XENDIT_SECRET_KEY=                                # [SECRET] xnd_development_…
XENDIT_WEBHOOK_TOKEN=                             # [SECRET] Dashboard (test mode) → Webhooks → verification token
ALLOW_LIVE_PAYMENTS=false                         # [TOML] locked
# Webhook URL to register in the Xendit TEST dashboard: <API_BASE_URL>/v1/webhooks/payments/xendit

# ---- notifications. With EMAIL_PROVIDER=log AND SMS_PROVIDER=log nobody can receive an OTP on staging:
# enable Resend (free tier, verified sender domain) or Google Sign-In before inviting testers.
EMAIL_PROVIDER=log                                # [TOML]; [VAR] resend once RESEND_API_KEY exists
EMAIL_FROM=JastipKita Staging <no-reply@antarkitaindonesia.com>   # [TOML]/[VAR]
EMAIL_REPLY_TO=                                   # [VAR]
RESEND_API_KEY=                                   # [SECRET]
PUSH_PROVIDER=log                                 # [TOML]; [VAR] fcm when Firebase exists
FCM_PROJECT_ID=                                   # [VAR]
FCM_SERVICE_ACCOUNT_JSON=                         # [SECRET] (whole JSON on one line)
SMS_PROVIDER=log                                  # [TOML]; twilio costs money per SMS → owner approval
TWILIO_ACCOUNT_SID=                               # [SECRET]
TWILIO_AUTH_TOKEN=                                # [SECRET]
TWILIO_FROM=                                      # [VAR]
TWILIO_WHATSAPP_FROM=                             # [VAR]
TWILIO_WHATSAPP_CONTENT_SID=                      # [VAR]

# ---- storage: Cloudflare R2 (free tier). memory is refused by env.ts on staging.
STORAGE_PROVIDER=s3                               # [TOML] locked
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # [VAR] required
S3_REGION=auto                                    # [TOML]
S3_BUCKET=jastipkita-staging                      # [TOML]/[VAR]
S3_ACCESS_KEY_ID=                                 # [SECRET] R2 API token (Object Read & Write, this bucket only)
S3_SECRET_ACCESS_KEY=                             # [SECRET]

# ---- other providers
FX_PROVIDER=frankfurter                           # [TOML] ECB reference rates (free, no key)
FX_FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
KYC_PROVIDER=manual                               # [TOML] admin review queue
MALWARE_SCAN_PROVIDER=mock                        # [TOML] labelled MOCK; ClamAV cannot run inside a Worker
CLAMAV_HTTP_URL=                                  # [VAR] only with MALWARE_SCAN_PROVIDER=clamav-http
INSURANCE_PROVIDER=mock                           # [TOML]
EXTRACTION_PROVIDER=heuristic                     # [TOML]
DB_ADMIN_PROVIDER=generic                         # [TOML] ("neon" adapter not wired yet)
NEON_API_KEY=                                     # [SECRET] optional (branch snapshots from CI)
NEON_PROJECT_ID=                                  # [VAR]  optional

SETTLEMENT_SECRETS_JSON={}                        # [SECRET] staging: keep {} or TEST data only
WORKER_ENABLED=true                               # [TOML]
WORKER_ID=cf-cron-staging                         # [TOML]

# ================= pipeline-only names (read by GitHub Actions, NOT by the API) =================
# CLOUDFLARE_API_TOKEN          [SECRET] start from the "Edit Cloudflare Workers" token template (Workers Scripts: Edit,
#                                        Account Settings: Read, User Details/Memberships: Read), add Cloudflare Pages: Edit
#                                        for the admin; restrict to this account (and zone, for custom domains)
# CLOUDFLARE_ACCOUNT_ID         [SECRET]
# DATABASE_URL_MIGRATOR         [SECRET] DIRECT (non-pooler) URL of jk_migrate_staging, sslmode=require
# DATABASE_URL_BACKUP           [SECRET] DIRECT URL of jk_backup_staging (read-only), sslmode=require
# BACKUP_ENCRYPTION_PUBLIC_KEY  [SECRET or VAR] age recipient "age1…" (public key; private key stays offline)
# BACKUP_S3_ENDPOINT / BACKUP_S3_BUCKET [VAR], BACKUP_S3_ACCESS_KEY_ID / BACKUP_S3_SECRET_ACCESS_KEY [SECRET] (optional)
# LANDING_DEPLOY_TOKEN          [SECRET] fine-grained PAT: repo erzamadana-ui/antarkita-landing, Contents: Read & write
# PG_MAJOR                      [VAR] server major version of Neon (default 17)
# ADMIN_PAGES_PROJECT           [VAR] Cloudflare Pages project name of the admin (optional)
# PUBLIC_API_BASE_URL, PUBLIC_SUPPORT_WHATSAPP, PUBLIC_SUPPORT_EMAIL, PUBLIC_PLAY_STORE_URL, PUBLIC_APP_STORE_URL,
# PUBLIC_ENABLE_GOOGLE_LOGIN, PUBLIC_GOOGLE_CLIENT_ID   [VAR] web build (public values only)
# LANDING_REPO, LANDING_BRANCH, LANDING_PATH, LANDING_ADD_NOJEKYLL   [VAR] web publishing (defaults in the workflow)
