# JastipKita API — PRODUCTION. PLACEHOLDERS ONLY. NOT LIVE. Names mirror apps/api/src/env.ts.
#
#   !!! WARNING — nothing in production may be switched on without the owner's written approval:
#   !!!   * paid services (Workers Paid, Neon paid plan, Twilio, Resend paid tier, Apple/Google developer accounts)
#   !!!   * LIVE payments (XENDIT_ENV=live + ALLOW_LIVE_PAYMENTS=true) — needs signed Xendit contract, written
#   !!!     confirmation about holding funds until delivery, legal review (docs/checklists/launch-checklist.md)
#   !!!   * store submission, ads
#
# Where values live (same scheme as staging.env.example):
#   [TOML] infra/cloudflare/wrangler.toml [env.production.vars]   [VAR] GitHub Environment "production" Variables
#   [SECRET] GitHub Environment "production" Secrets (→ Worker secrets via deploy-production.yml)
# XENDIT_ENV and ALLOW_LIVE_PAYMENTS are NOT set by hand: deploy-production.yml derives them from the recorded
# decision variable ALLOW_LIVE_PAYMENTS (+ LIVE_PAYMENTS_DECISION_REF) and the input checkbox.

APP_ENV=production                                # [TOML] locked
APP_NAME=JastipKita
APP_VERSION=                                      # set by CI
API_BASE_URL=https://jastipkita-api.antarkitaindonesia.com   # [VAR] custom domain (zone must be on Cloudflare DNS)
WEB_BASE_URL=https://antarkitaindonesia.com/jastipkita        # [TOML]
ADMIN_BASE_URL=https://<admin-host>               # [VAR] admin behind Cloudflare Access (Zero Trust)
CORS_ORIGINS=https://antarkitaindonesia.com       # [TOML]/[VAR]
LOG_LEVEL=info
PORT=8787

# Production DB: NOT the Neon free plan (6 h PITR, compute quota) — see docs/08-backup-dr.md §2 for the plan
# needed to meet RPO ≤ 15 min / RTO ≤ 4 h (paid → owner approval).
DATABASE_URL=postgres://jk_api_production:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require  # [SECRET]
DB_POOL_MAX=1
DB_PROVIDER=neon

JWT_SECRET=                                       # [SECRET] generate: bash scripts/gen-secrets.sh production
JWT_ISSUER=jastipkita-api
JWT_AUDIENCE=jastipkita
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_MFA_STEP_UP_SEC=900
ADMIN_SESSION_MFA_MAX_AGE_SEC=43200
DATA_ENCRYPTION_KEYS=                             # [SECRET] separate from staging; keep an offline escrow copy (DPO)
HMAC_PEPPER=                                      # [SECRET] never changes after launch
GOOGLE_CLIENT_IDS=                                # [VAR]
APPLE_CLIENT_IDS=                                 # [VAR]
OTP_DEV_ECHO=false                                # locked

PAYMENT_PROVIDER=xendit                           # mock is refused by env.ts in production
XENDIT_ENV=                                       # derived by the workflow (test until the LIVE decision)
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_SECRET_KEY=                                # [SECRET] xnd_production_… ONLY after contract + approval
XENDIT_WEBHOOK_TOKEN=                             # [SECRET]
ALLOW_LIVE_PAYMENTS=                              # derived by the workflow — never edit by hand

EMAIL_PROVIDER=resend                             # [TOML]
EMAIL_FROM=JastipKita <no-reply@antarkitaindonesia.com>
EMAIL_REPLY_TO=                                   # [VAR] support address
RESEND_API_KEY=                                   # [SECRET]
PUSH_PROVIDER=fcm                                 # [TOML]
FCM_PROJECT_ID=                                   # [VAR]
FCM_SERVICE_ACCOUNT_JSON=                         # [SECRET]
SMS_PROVIDER=twilio                               # [TOML] paid per message → owner approval
TWILIO_ACCOUNT_SID=                               # [SECRET]
TWILIO_AUTH_TOKEN=                                # [SECRET]
TWILIO_FROM=                                      # [VAR]
TWILIO_WHATSAPP_FROM=                             # [VAR]
TWILIO_WHATSAPP_CONTENT_SID=                      # [VAR] approved WhatsApp authentication template

STORAGE_PROVIDER=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com    # [VAR]
S3_REGION=auto
S3_BUCKET=jastipkita-production
S3_ACCESS_KEY_ID=                                 # [SECRET]
S3_SECRET_ACCESS_KEY=                             # [SECRET]

FX_PROVIDER=frankfurter
FX_FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
KYC_PROVIDER=manual
# Real malware scanning: a clamd service with the HTTP shim (not possible inside Workers) → hosting cost, owner approval.
MALWARE_SCAN_PROVIDER=clamav-http
CLAMAV_HTTP_URL=                                  # [VAR]
INSURANCE_PROVIDER=mock                           # until an insurance partner contract exists (labelled MOCK)
EXTRACTION_PROVIDER=heuristic
DB_ADMIN_PROVIDER=generic
NEON_API_KEY=                                     # [SECRET] pre-deploy branch snapshots
NEON_PROJECT_ID=                                  # [VAR]

# Settlement bank accounts: ONLY here (secret store), referenced by settlement_accounts.secret_ref; changed via
# Admin maker-checker (FINANCE_SUPER_ADMIN + MFA). Never paste account numbers anywhere else.
SETTLEMENT_SECRETS_JSON={}                        # [SECRET]
WORKER_ENABLED=true
WORKER_ID=cf-cron-production

# ================= pipeline-only names (GitHub Environment "production") =================
# CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID           [SECRET]
# DATABASE_URL_MIGRATOR, DATABASE_URL_BACKUP            [SECRET] direct (non-pooler) URLs
# BACKUP_ENCRYPTION_PUBLIC_KEY                          [SECRET or VAR] age1…
# NEON_PRODUCTION_BRANCH_ID, NEON_PREDEPLOY_BRANCHES_KEEP [VAR]
# ALLOW_LIVE_PAYMENTS ("true"|"false"), LIVE_PAYMENTS_DECISION_REF   [VAR] the recorded owner decision
# PRODUCTION_DEPLOYERS                                  [VAR, repository level] comma-separated GitHub logins
