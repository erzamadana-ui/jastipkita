# JastipKita API — DEVELOPMENT (local machine / docker compose). Names mirror apps/api/src/env.ts.
# Copy to apps/api/.env (git-ignored) or pass with `docker run --env-file`. No real credentials here, ever.
# Generate local secrets:  bash scripts/gen-secrets.sh development

# ---- app
APP_ENV=development
APP_NAME=JastipKita
APP_VERSION=0.1.0
API_BASE_URL=http://localhost:8787
WEB_BASE_URL=http://localhost:4321
ADMIN_BASE_URL=http://localhost:5173
# Browser origins (scheme://host:port, no path). WEB_BASE_URL/ADMIN_BASE_URL are added automatically.
CORS_ORIGINS=http://localhost:4321,http://localhost:5173
LOG_LEVEL=debug
PORT=8787

# ---- database (local Postgres 16 from infra/docker/docker-compose.yml; role created by the `migrate` service)
DATABASE_URL=postgres://jk_api_dev:jk_api_dev@localhost:5432/jastipkita_dev
DB_POOL_MAX=10
DB_PROVIDER=postgres

# ---- auth & crypto  [SECRET in every non-local environment]
JWT_SECRET=
JWT_ISSUER=jastipkita-api
JWT_AUDIENCE=jastipkita
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_MFA_STEP_UP_SEC=900
DATA_ENCRYPTION_KEYS=
HMAC_PEPPER=
# OAuth client IDs are public identifiers (comma-separated: web, android, ios)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Development/test only: OTP code is echoed in the API response (env.ts refuses it on staging/production)
OTP_DEV_ECHO=true

# ---- payments: MOCK (dev routes /v1/dev/mock-checkout/* simulate paying)
PAYMENT_PROVIDER=mock
XENDIT_ENV=test
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
ALLOW_LIVE_PAYMENTS=false

# ---- notifications (log = MOCK)
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@localhost
EMAIL_REPLY_TO=
RESEND_API_KEY=
PUSH_PROVIDER=log
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

# ---- storage: memory (dev routes /v1/dev/storage/*). For MinIO: STORAGE_PROVIDER=s3, S3_ENDPOINT=http://minio:9000
STORAGE_PROVIDER=memory
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- other providers
FX_PROVIDER=static
FX_FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
KYC_PROVIDER=manual
MALWARE_SCAN_PROVIDER=mock
CLAMAV_HTTP_URL=
INSURANCE_PROVIDER=mock
EXTRACTION_PROVIDER=heuristic
# "neon" is not wired yet (throws) — keep generic
DB_ADMIN_PROVIDER=generic
NEON_API_KEY=
NEON_PROJECT_ID=

# ---- settlement accounts: JSON map secret_ref → account (server secret store only, never in the DB/clients)
SETTLEMENT_SECRETS_JSON={}

# ---- background worker (Node: in-process loop every 5 s; Workers: Cron Trigger)
WORKER_ENABLED=true
WORKER_ID=worker-dev
