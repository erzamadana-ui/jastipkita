{
  "name": "@jastipkita/design-tokens",
  "version": "1.0.0",
  "private": true,
  "description": "JastipKita design tokens (colour, type, spacing, radii, elevation, motion, glass) — source: tokens.json. Emits CSS custom properties, a typed TS module and Flutter Dart constants.",
  "type": "module",
  "main": "./dist/tokens.ts",
  "types": "./dist/tokens.ts",
  "exports": {
    ".": "./dist/tokens.ts",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./tokens.json",
    "./resolved.json": "./dist/tokens.resolved.json"
  },
  "files": ["dist", "tokens.json", "CONTRAST.md"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node scripts/build.mjs --check"
  }
}
