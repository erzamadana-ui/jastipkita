---
import Icon from './Icon.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { url } from '../lib/paths.ts';
import { CONFIG, SITE } from '../config.ts';
import type { Crumb } from '../lib/seo.ts';

interface Props { lang: 'id' | 'en'; crumbs: Crumb[] }
const { lang, crumbs } = Astro.props;
const id = lang === 'id';
const t = (a: string, b: string) => (id ? a : b);
// Mirrors db/seeds/0001_reference.sql → data_retention_policies (all flagged is_assumption = true).
const retention: Array<[string, string, string, string]> = [
  [t('Catatan keuangan (transaksi, pembayaran, refund, payout, buku besar)', 'Financial records (transactions, payments, refunds, payouts, ledger)'), t('10 tahun sejak dibuat', '10 years from creation'), t('Kewajiban pembukuan (UU KUP)', 'Bookkeeping duty (tax law)'), t('Disimpan, tidak dipakai untuk pemasaran', 'Kept, never used for marketing')],
  [t('Data identitas & dokumen KYC (KTP/paspor, selfie)', 'Identity & KYC documents (ID, selfie)'), t('5 tahun setelah akun ditutup', '5 years after closure'), t('Praktik APU-PPT (anti pencucian uang)', 'AML/CFT practice'), t('Terenkripsi, lalu dihapus', 'Encrypted, then deleted')],
  [t('Log audit & bukti rekonsiliasi pembayaran', 'Audit logs & payment reconciliation evidence'), t('5–10 tahun', '5–10 years'), t('Keamanan & kewajiban keuangan', 'Security & financial obligations'), t('Disimpan', 'Kept')],
  [t('Pesan chat terkait transaksi', 'Transaction chat messages'), t('2 tahun setelah transaksi selesai', '2 years after the transaction closes'), t('Bukti sengketa', 'Dispute evidence'), t('Dianonimkan', 'Anonymised')],
  [t('Alamat pengiriman', 'Delivery addresses'), t('90 hari setelah transaksi selesai', '90 days after the transaction closes'), t('Minimisasi data', 'Data minimisation'), t('Dianonimkan', 'Anonymised')],
  [t('Log keamanan (login, perangkat)', 'Security logs (sign-ins, devices)'), t('12 bulan', '12 months'), t('Investigasi keamanan', 'Security investigations'), t('Dihapus', 'Deleted')],
  [t('Profil, perangkat, token notifikasi, preferensi', 'Profile, devices, push tokens, preferences'), t('Saat penghapusan final (hari ke-14)', 'At final deletion (day 14)'), '—', t('Dihapus / dianonimkan', 'Deleted / anonymised')],
];
---
<section class="page-hero">
  <div class="container container-narrow">
    <Breadcrumbs items={crumbs} lang={lang} />
    <span class="eyebrow" style="margin-top:18px"><Icon name="trash-2" size={16} />{t('Privasi', 'Privacy')}</span>
    <h1>{t('Cara menghapus akun & data JastipKita', 'How to delete your JastipKita account & data')}</h1>
    <p class="lead">{t(
      'Kamu bisa menghapus akun kapan saja, dari aplikasi maupun dari situs ini. Halaman ini menjelaskan langkahnya, data apa yang dihapus, dan data apa yang wajib kami simpan lebih lama.',
      'You can delete your account at any time, in the app or on this website. This page explains the steps, what is deleted and what we must keep for longer.',
    )}</p>
    <p class="small muted" style="margin-top:10px">{t('Aplikasi', 'App')}: JastipKita ({CONFIG.androidPackage}) · {t('Pengembang', 'Developer')}: JastipKita — {SITE.companyName}</p>
  </div>
</section>
<section class="section-tight" style="padding-top:0">
  <div class="container container-narrow stack" style="--stack:20px">
    <div class="grid grid-2" style="--gap:16px">
      <div class="card">
        <span class="icon-tile"><Icon name="smartphone" /></span>
        <h2 class="h-card" style="margin-top:12px">{t('Di aplikasi', 'In the app')}</h2>
        <ol class="small del-steps">
          <li>{t('Buka tab Profil.', 'Open the Profile tab.')}</li>
          <li>{t('Pilih Keamanan & privasi → Hapus akun.', 'Choose Security & privacy → Delete account.')}</li>
          <li>{t('Baca dampaknya, lalu konfirmasi.', 'Review the impact, then confirm.')}</li>
        </ol>
      </div>
      <div class="card">
        <span class="icon-tile"><Icon name="monitor" /></span>
        <h2 class="h-card" style="margin-top:12px">{t('Di situs web', 'On the website')}</h2>
        <ol class="small del-steps">
          <li><a href={url('/masuk/?next=/jastipkita/akun/')}>{t('Masuk', 'Sign in')}</a> {t('dengan kode OTP e-mail/HP.', 'with an e-mail/phone OTP.')}</li>
          <li>{t('Buka halaman', 'Open')} <a href={url('/akun/#hapus')}>{t('Akun → Hapus akun', 'Account → Delete account')}</a>.</li>
          <li>{t('Centang konfirmasi dan kirim permintaan.', 'Tick the confirmation and submit.')}</li>
        </ol>
      </div>
    </div>
    <div class="card">
      <h2 class="h-card">{t('Yang terjadi setelah kamu mengajukan', 'What happens next')}</h2>
      <ul class="list-check" role="list" style="margin-top:14px">
        <li><Icon name="clock" /><span>{t('Penghapusan dijadwalkan 14 hari. Semua sesi dikeluarkan; kamu bisa masuk lagi untuk membatalkan selama masa tenggang.', 'Deletion is scheduled for 14 days later. All sessions are signed out; you can sign in again to cancel during the grace period.')}</span></li>
        <li><Icon name="ban" /><span>{t('Permintaan ditolak sementara bila masih ada transaksi berjalan, dispute terbuka, refund, atau payout yang belum selesai — selesaikan dulu agar uang siapa pun tidak tertahan.', 'Requests are refused while transactions, disputes, refunds or payouts are still open — so nobody’s money gets stuck.')}</span></li>
        <li><Icon name="user-check" /><span>{t('Pada hari ke-14 profil dianonimkan: nama, e-mail, nomor HP, foto, perangkat, dan token notifikasi dihapus. E-mail disimpan dalam bentuk hash untuk mencegah penyalahgunaan pendaftaran ulang.', 'On day 14 your profile is anonymised: name, e-mail, phone, photo, devices and push tokens are removed. The e-mail is kept only as a hash to prevent sign-up abuse.')}</span></li>
        <li><Icon name="gift" /><span>{t('JastipKita Credit dan kode referral hangus.', 'JastipKita Credit and your referral code expire.')}</span></li>
      </ul>
    </div>
    <div>
      <h2 class="h-card">{t('Data yang wajib disimpan lebih lama', 'Data we must keep for longer')}</h2>
      <div class="table-wrap" style="margin-top:12px">
        <table class="table">
          <thead><tr><th scope="col">{t('Data', 'Data')}</th><th scope="col">{t('Lama simpan', 'Retention')}</th><th scope="col">{t('Alasan', 'Reason')}</th><th scope="col">{t('Tindakan', 'Action')}</th></tr></thead>
          <tbody>{retention.map(([a, b, c, d]) => <tr><td>{a}</td><td>{b}</td><td>{c}</td><td>{d}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="xsmall muted" style="margin-top:8px">{t('Durasi retensi adalah asumsi internal yang sedang ditinjau konsultan hukum; versi final akan tercantum di Kebijakan Privasi.', 'Retention periods are internal assumptions under legal review; the final version will be in the Privacy Policy.')} <a href={url('/legal/privacy-policy/')}>{t('Kebijakan Privasi', 'Privacy Policy (ID)')}</a></p>
    </div>
    <div class="note note-neutral">
      <Icon name="mail" />
      <p>
        <strong>{t('Tidak bisa masuk ke akun?', 'Can’t sign in?')}</strong>{' '}
        {t('Kirim permintaan penghapusan dari e-mail atau nomor HP yang terdaftar ke', 'Send a deletion request from your registered e-mail or phone number to')}{' '}
        {CONFIG.supportEmail ? <a href={`mailto:${CONFIG.supportEmail}?subject=${encodeURIComponent('Permintaan hapus akun')}`}>{CONFIG.supportEmail}</a> : <span>{t('[e-mail privasi — akan diumumkan sebelum peluncuran]', '[privacy e-mail — to be announced before launch]')}</span>}.
        {' '}{t('Kami akan memverifikasi identitasmu sebelum memproses, dan tidak pernah meminta kode OTP atau PIN.', 'We will verify your identity before processing and will never ask for your OTP code or PIN.')}
      </p>
    </div>
  </div>
</section>
<style>
  .del-steps { margin: 10px 0 0; padding-left: 1.2em; display: grid; gap: 6px; }
  .list-check :global(svg) { color: var(--jk-color-secondary); }
</style>
