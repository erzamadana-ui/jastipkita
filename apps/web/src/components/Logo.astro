---
// Brand logo, inlined from brand/logo (outlined paths, generated by brand/scripts). Colours are swapped to
// CSS variables so the SAME geometry renders the default variant on light and the "-dark" variant
// (off-white bag + cobalt-400 orbit) on dark — exactly the two approved colourways (BRAND-GUIDE §1.2).
import horizontal from '../assets/brand/jastipkita-horizontal.svg?raw';
import symbol from '../assets/brand/jastipkita-symbol.svg?raw';

interface Props {
  variant?: 'horizontal' | 'symbol';
  class?: string;
  /** Force colours, e.g. on the navy hero. */
  tone?: 'auto' | 'on-dark';
  title?: string;
}
const { variant = 'horizontal', class: className, tone = 'auto', title = 'JastipKita' } = Astro.props;
const raw = variant === 'symbol' ? symbol : horizontal;
const ink = tone === 'on-dark' ? 'var(--jk-color-offwhite-50)' : 'var(--logo-ink)';
const accent = tone === 'on-dark' ? 'var(--jk-color-cobalt-400)' : 'var(--logo-accent)';
const svg = raw
  .replace(/<title>.*?<\/title>/, `<title>${title}</title>`)
  .replace(/fill="#0B1E4A"/gi, `fill="${ink}"`)
  .replace(/fill="#1E5BFF"/gi, `fill="${accent}"`)
  .replace(/\swidth="[^"]*"\s+height="[^"]*"/, '')
  .replace('<svg ', `<svg class="${className ?? ''}" `);
---
<Fragment set:html={svg} />
