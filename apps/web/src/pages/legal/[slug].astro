---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbLd, webPageLd } from '../../lib/seo.ts';
import { url } from '../../lib/paths.ts';

export async function getStaticPaths() {
  const docs = await getCollection('legal');
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}
const { doc } = Astro.props;
// Version/date shown here come from docs/legal front-matter; scripts/legal-versions.ts swaps in the API's latest
// published version & effective date (GET /v1/legal/documents) when the API is reachable.
const { Content, headings } = await render(doc);
const toc = headings.filter((h: { depth: number }) => h.depth === 2 || h.depth === 3);
const path = `/legal/${doc.id}/`;
const crumbs = [{ name: 'Beranda', path: '/' }, { name: 'Legal', path: '/legal/' }, { name: doc.data.title, path }];
---
<Base title={doc.data.title} description={doc.data.description} path={path} ogType="article" jsonLd={[webPageLd({ name: doc.data.title, description: doc.data.description, path }), breadcrumbLd(crumbs)]}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1>{doc.data.title}</h1>
      <div data-legal-slug={doc.id} data-static-version={doc.data.version}>
        <p class="small muted mt-10">
          Versi <span data-legal-version>{doc.data.version}</span> · Berlaku sejak <span data-legal-effective>{doc.data.effectiveDate}</span>
          <span class="chip chip-success legal-live" data-legal-live hidden>terverifikasi dengan server</span>
        </p>
        <p class="note note-warning legal-newer" data-legal-newer hidden><span data-legal-newer-text></span></p>
      </div>
    </div>
  </section>
  <section class="section-tight pt-0">
    <div class="container">
      <div class="legal-layout">
        <aside class="toc" aria-labelledby="toc-title">
          <details open>
            <summary id="toc-title">Daftar isi</summary>
            <ol>
              {toc.map((h: { depth: number; slug: string; text: string }) => <li class={`lvl-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </details>
          <p class="xsmall muted mt-16"><a href={url('/legal/')}>Semua dokumen legal</a></p>
        </aside>
        <div>
          <article class="prose legal-prose" data-legal>
            <Content />
          </article>
        </div>
      </div>
    </div>
  </section>
  <script>
    import '../../scripts/legal-versions.ts';
  </script>
</Base>

<style>
  .legal-live { margin-left: 6px; vertical-align: 1px; }
  .legal-newer { margin-top: 12px; max-width: 720px; }
</style>
