---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/paths.ts';
import { CONFIG } from '../../config.ts';
import { LEGAL_SLUGS, SIGNUP_OPTIONAL, SIGNUP_REQUIRED, type LegalType } from '../../lib/legal-catalog.ts';

// Offline fallback for consent versions: read at BUILD time from docs/legal/*.md front-matter (same source the API
// seeds its published documents from). At runtime GET /v1/consents/requirements always wins when reachable.
const docs = await getCollection('legal');
const fallback: Partial<Record<LegalType, { version: string; title: string; url: string }>> = {};
for (const type of [...SIGNUP_REQUIRED, ...SIGNUP_OPTIONAL]) {
  const doc = docs.find((d) => d.id === LEGAL_SLUGS[type]);
  if (!doc) throw new Error(`docs/legal/${LEGAL_SLUGS[type]}.md is missing (needed for signup consents)`);
  fallback[type] = { version: doc.data.version, title: doc.data.title, url: url(`/legal/${doc.id}/`) };
}
const items = [
  ...SIGNUP_REQUIRED.map((type) => ({ type, required: true, ...fallback[type]! })),
  ...SIGNUP_OPTIONAL.map((type) => ({ type, required: false, ...fallback[type]! })),
];
---
<Base title="Masuk" description="Masuk ke akun JastipKita dengan kode sekali pakai (OTP) lewat e-mail atau nomor HP." path="/masuk/" noindex>
  <section class="section-tight">
    <div class="container maxw-520">
      <div class="card auth-card">
        <span class="icon-tile"><Icon name="log-in" /></span>
        <h1 class="auth-title">Masuk ke JastipKita</h1>
        <p class="small muted">Tanpa kata sandi — kami kirim kode 6 digit. Akun baru dibuat otomatis setelah kamu menyetujui Syarat & Ketentuan dan Kebijakan Privasi.</p>

        {CONFIG.apiIsPlaceholder && (
          <div class="note note-warning mt-16"><Icon name="clock" /><p>Layanan akun belum dibuka untuk umum. Formulir ini akan berfungsi saat server JastipKita aktif.</p></div>
        )}

        <form id="otp-request" class="form-grid mt-20" novalidate>
          <fieldset class="seg" aria-label="Metode">
            <legend class="sr-only">Kirim kode lewat</legend>
            <label><input type="radio" name="channel" value="EMAIL" checked /><span>E-mail</span></label>
            <label><input type="radio" name="channel" value="WHATSAPP" /><span>WhatsApp</span></label>
            <label><input type="radio" name="channel" value="SMS" /><span>SMS</span></label>
          </fieldset>
          <div class="field">
            <label for="destination" id="dest-label">Alamat e-mail</label>
            <input class="input" id="destination" name="destination" type="email" autocomplete="email" inputmode="email" required maxlength="254" placeholder="nama@email.com" />
          </div>
          <div class="error-text" id="req-error" role="alert" hidden></div>
          <button class="btn btn-primary btn-block" type="submit" id="req-btn">Kirim kode</button>
        </form>

        <form id="otp-verify" class="form-grid mt-20" novalidate hidden>
          <p class="small" id="sent-to"></p>
          <div class="field">
            <label for="code">Kode 6 digit</label>
            <input class="input tnum otp-input" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="\d{6}" maxlength="6" required />
          </div>
          <div class="error-text" id="ver-error" role="alert" hidden></div>
          <button class="btn btn-primary btn-block" type="submit" id="ver-btn">Verifikasi & masuk</button>
          <button class="btn btn-ghost btn-block" type="button" id="restart">Ganti e-mail / nomor</button>
        </form>

        <form id="consent-form" class="form-grid mt-20" novalidate hidden>
          <fieldset class="consents">
            <legend class="small fw-600 mb-8">Akun baru — mohon setujui dokumen berikut:</legend>
            <div id="consent-list" class="consent-list">
              {items.map((i) => (
                <label class="check">
                  <input type="checkbox" data-consent-type={i.type} data-required={i.required ? 'true' : 'false'} />
                  <span>
                    {i.required ? 'Saya menyetujui ' : 'Saya bersedia menerima kabar promo & produk sesuai '}
                    <a href={i.url} target="_blank" rel="noopener">{i.title}</a>
                    {' '}<span class="xsmall muted" data-consent-version>(versi {i.version})</span>
                    {i.required ? ' — wajib' : ' — opsional, bisa dicabut kapan saja'}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
          <p class="xsmall muted" id="consent-source">Versi dokumen dari salinan situs; akan dicocokkan dengan server saat kamu melanjutkan.</p>
          <div class="error-text" id="consent-error" role="alert" hidden></div>
          <button class="btn btn-primary btn-block" type="submit" id="consent-btn">Setujui & buat akun</button>
        </form>
        <script type="application/json" id="consent-fallback" set:html={JSON.stringify(fallback).replace(/</g, '\\u003c')}></script>

        {CONFIG.enableGoogleLogin && CONFIG.googleClientId && (
          <div class="mt-20">
            <div class="or"><span>atau</span></div>
            <button class="btn btn-block" type="button" id="google-btn" data-client-id={CONFIG.googleClientId}>Masuk dengan Google</button>
            <p class="xsmall muted mt-6">Memuat skrip Google Identity Services hanya setelah tombol ditekan.</p>
          </div>
        )}
        <p class="xsmall muted mt-20">Token akses hanya disimpan di memori halaman; token penyegar disimpan di tab ini saja (sessionStorage) dan hilang saat tab ditutup atau kamu keluar. Kami tidak memakai cookie pelacak.</p>
      </div>
    </div>
  </section>
  <script>
    import '../../scripts/login.ts';
  </script>
</Base>
<style>
  .auth-card { padding: 28px; }
  .auth-title { font-size: 1.5rem; font-weight: 600; margin-top: 14px; }
  .seg { border: 0; padding: 4px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; background: var(--jk-color-surface-muted); border-radius: var(--jk-radius-pill); border: 1px solid var(--card-border); }
  .seg label { position: relative; }
  .seg input { position: absolute; opacity: 0; inset: 0; }
  .seg span { display: grid; place-items: center; min-height: 40px; border-radius: var(--jk-radius-pill); font-size: 0.875rem; font-weight: 500; cursor: pointer; }
  .seg input:checked + span { background: var(--jk-color-surface); box-shadow: var(--jk-elevation-level1); color: var(--jk-color-on-surface); font-weight: 600; }
  .seg input:focus-visible + span { outline: 2px solid var(--jk-color-focus-ring); outline-offset: 2px; }
  .otp-input { font-size: 1.5rem; letter-spacing: 0.4em; text-align: center; }
  .consents { border: 1px solid var(--card-border); border-radius: var(--jk-radius-md); padding: 14px; }
  .consent-list { display: grid; gap: 10px; }
  .or { display: flex; align-items: center; gap: 12px; color: var(--jk-color-on-surface-muted); font-size: 0.8125rem; margin-bottom: 14px; }
  .or::before, .or::after { content: ''; flex: 1; height: 1px; background: var(--jk-color-divider); }
</style>
