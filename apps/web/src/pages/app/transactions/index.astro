---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import StoreButtons from '../../../components/StoreButtons.astro';
import { url } from '../../../lib/paths.ts';
import { CONFIG } from '../../../config.ts';
---
<Base title="Buka di aplikasi JastipKita" description="Detail transaksi JastipKita hanya tersedia di aplikasi." path="/app/transactions/" noindex>
  <section class="section-tight">
    <div class="container maxw-560">
      <div class="card deeplink" data-scheme={CONFIG.appScheme} data-package={CONFIG.androidPackage}>
        <span class="icon-tile"><Icon name="smartphone" /></span>
        <h1 class="dl-title">Buka di aplikasi JastipKita</h1>
        <p class="small muted">Detail transaksi, status SafePay, chat, dan serah terima hanya tersedia di aplikasi agar data transaksimu tetap aman.</p>
        <p class="dl-id" id="dl-id" hidden>Nomor transaksi: <strong class="tnum"></strong></p>
        <p class="error-text" id="dl-invalid" hidden><Icon name="circle-alert" size={16} />Tautan transaksi tidak valid.</p>
        <div class="stack st-12 mt-20">
          <a class="btn btn-primary btn-block" id="dl-open" href="#" hidden><Icon name="external-link" />Buka aplikasi</a>
          <StoreButtons />
          <a class="btn btn-ghost btn-block" href={url('/akun/')}><Icon name="user-check" />Lihat akun di web</a>
        </div>
        <p class="xsmall muted mt-16">Belum punya aplikasinya? Aplikasi JastipKita belum diluncurkan; tautan toko aplikasi akan aktif saat rilis.</p>
      </div>
    </div>
  </section>
  <script>
    import '../../../scripts/deeplink.ts';
  </script>
</Base>
<style>
  .deeplink { padding: 28px; text-align: left; }
  .dl-title { font-size: 1.5rem; font-weight: 600; margin-top: 14px; }
  .dl-id { margin-top: 14px; padding: 10px 14px; background: var(--jk-color-surface-muted); border-radius: var(--jk-radius-md); font-size: 0.9375rem; }
</style>
