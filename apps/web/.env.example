# Build-time public configuration for @jastipkita/web (inlined into the static bundle — never put secrets here).

# Base URL of the JastipKita API (no trailing slash; the site appends /v1/...).
# Default when unset: https://api.antarkitaindonesia.com/jastipkita (placeholder — API not deployed yet).
PUBLIC_API_BASE_URL=

# Customer-support WhatsApp number in international format without "+" (e.g. 628xxxxxxxxxx).
# Empty = the site shows "kanal CS segera diumumkan" instead of a link.
PUBLIC_SUPPORT_WHATSAPP=

# Support e-mail shown on the site and in legal pages. Empty = placeholder text.
PUBLIC_SUPPORT_EMAIL=

# Store listing URLs. Empty = buttons render as "Segera hadir" (disabled), never as fake links.
PUBLIC_PLAY_STORE_URL=
PUBLIC_APP_STORE_URL=

# Show the "Masuk dengan Google" button on /masuk/ (requires the API's Google client to be configured).
PUBLIC_ENABLE_GOOGLE_LOGIN=false
# Google OAuth web client id (public). Only used when PUBLIC_ENABLE_GOOGLE_LOGIN=true.
PUBLIC_GOOGLE_CLIENT_ID=
