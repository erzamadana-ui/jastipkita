{
  "name": "@jastipkita/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JastipKita public website (Astro, static) — served at https://antarkitaindonesia.com/jastipkita/",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "node scripts/sync-content.mjs && astro dev",
    "build": "node scripts/sync-content.mjs && astro build && node scripts/postbuild.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "check": "node scripts/sync-content.mjs && astro check",
    "test": "node --test tests/unit/*.test.mjs && playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:smoke": "playwright test",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@jastipkita/core": "workspace:*",
    "@jastipkita/design-tokens": "workspace:*",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.56.1",
    "typescript": "^5.9.3"
  }
}
