# JastipKita Admin (React SPA, static) — BUILD-TIME public configuration.
# Everything here is inlined into the JavaScript bundle and visible to anyone who loads the page:
# NEVER put secrets, API keys, settlement data or credentials here. Auth = admin login + TOTP MFA against the API.
# Names assume Vite (VITE_ prefix); adjust together with deploy-staging.yml if the admin uses another bundler.

# API base URL without trailing slash (the app calls <base>/v1/admin/...).
# Local: http://localhost:8787   Staging: https://jastipkita-api-staging.<subdomain>.workers.dev
VITE_API_BASE_URL=http://localhost:8787

# development | staging | production — non-production shows a permanent SANDBOX/STAGING badge.
VITE_APP_ENV=development

# Public base path of the SPA ("/" on Cloudflare Pages; "/jastipkita-admin/" if ever served from a sub-path).
VITE_BASE_PATH=/

# Hosting notes (docs/07-deployment.md §7):
# * The admin origin (e.g. https://staging.<project>.pages.dev) must equal the API's ADMIN_BASE_URL, otherwise CORS
#   rejects the browser. * Not indexed: deploy adds robots.txt "Disallow: /" and X-Robots-Tag: noindex.
# * Recommended: put the admin behind Cloudflare Access (Zero Trust free tier) in addition to MFA.
