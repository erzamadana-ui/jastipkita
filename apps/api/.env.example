# JastipKita API — environment variables (NAMES ONLY; never commit real values).
# Copy to .env for local development. In staging/production these are secrets in the host's vault
# (Cloudflare Workers secrets / GitHub Environments / cloud secret manager).

APP_ENV=development
APP_VERSION=0.1.0
API_BASE_URL=http://localhost:8787
WEB_BASE_URL=http://localhost:4321
ADMIN_BASE_URL=http://localhost:5173
CORS_ORIGINS=
LOG_LEVEL=info
PORT=8787

DATABASE_URL=postgres://jk_api_dev:CHANGE_ME@localhost:5432/jastipkita_dev
DB_POOL_MAX=10
DB_PROVIDER=postgres

# ≥ 32 random chars:  openssl rand -base64 48
JWT_SECRET=
# "kid:base64(32 bytes)" comma-separated, active key first:  echo "k1:$(openssl rand -base64 32)"
DATA_ENCRYPTION_KEYS=
# ≥ 32 random chars
HMAC_PEPPER=

# OAuth client IDs (public identifiers, not secrets)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# SEC-15: providers whose ID tokens must carry a nonce (csv GOOGLE,APPLE | none). Empty = APPLE (default).
# Add GOOGLE once every Google client (web already does, mobile not yet) sends a nonce. Production must keep APPLE.
OAUTH_REQUIRE_NONCE=
# Development only: echo OTP codes in API responses (forbidden in staging/production)
OTP_DEV_ECHO=false

# Payments — mock | xendit.  Staging uses Xendit TEST mode. LIVE requires ALLOW_LIVE_PAYMENTS=true (owner approval).
PAYMENT_PROVIDER=mock
XENDIT_ENV=test
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
ALLOW_LIVE_PAYMENTS=false

EMAIL_PROVIDER=log
EMAIL_FROM="JastipKita <no-reply@example.com>"
EMAIL_REPLY_TO=
RESEND_API_KEY=

PUSH_PROVIDER=log
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

STORAGE_PROVIDER=memory
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

FX_PROVIDER=static
FX_FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1

KYC_PROVIDER=manual
MALWARE_SCAN_PROVIDER=mock
CLAMAV_HTTP_URL=
INSURANCE_PROVIDER=mock
EXTRACTION_PROVIDER=heuristic

DB_ADMIN_PROVIDER=generic
NEON_API_KEY=
NEON_PROJECT_ID=

# Server-side secret store ONLY. Map of secret_ref → settlement account; never exposed to clients.
# {"SETTLEMENT_MAIN":{"bankCode":"...","accountNumber":"...","holderName":"..."}}
SETTLEMENT_SECRETS_JSON={}

# Published consumer-complaint channels (GET /v1/support/complaint-info; Permendag 19/2026). Public values, not secrets.
# Empty → null ("segera diumumkan"). WhatsApp digits only, e.g. 628xxxxxxxxxx. Keep equal to apps/web PUBLIC_SUPPORT_*.
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=

WORKER_ENABLED=true
WORKER_ID=worker-1

# Added: names present in src/env.ts
APP_NAME=
JWT_ISSUER=
JWT_AUDIENCE=
ACCESS_TOKEN_TTL_SEC=
REFRESH_TOKEN_TTL_DAYS=
ADMIN_MFA_STEP_UP_SEC=
ADMIN_SESSION_MFA_MAX_AGE_SEC=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
