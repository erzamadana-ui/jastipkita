{
  "name": "@jastipkita/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JastipKita HTTP API (Hono). Runs on Node (dev/test/containers) and Cloudflare Workers.",
  "scripts": {
    "dev": "tsx watch src/server.node.ts",
    "start": "tsx src/server.node.ts",
    "worker:run": "tsx src/worker.node.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "openapi": "tsx scripts/export-openapi.ts",
    "db:migrate": "bash ../../db/scripts/migrate.sh",
    "db:seed": "bash ../../db/scripts/seed.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/zod-openapi": "^1.6.3",
    "@jastipkita/core": "workspace:*",
    "aws4fetch": "^1.0.20",
    "hono": "^4.10.0",
    "jose": "^6.2.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "@types/node": "^22.0.0"
  }
}
