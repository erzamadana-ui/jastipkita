{
  "name": "jastipkita",
  "private": true,
  "description": "JastipKita — Titip Mudah, Aman, Terpercaya. Trusted Global P2P Shopping & Traveler Marketplace.",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:migrate": "pnpm --filter @jastipkita/api db:migrate",
    "db:seed": "pnpm --filter @jastipkita/api db:seed",
    "dev:api": "pnpm --filter @jastipkita/api dev",
    "dev:admin": "pnpm --filter @jastipkita/admin dev",
    "dev:web": "pnpm --filter @jastipkita/web dev"
  }
}
